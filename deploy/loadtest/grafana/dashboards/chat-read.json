{
  "uid": "chat-read-loadtest",
  "title": "읽음 기준선 측정",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "메시지 저장 p95/p99 (서버, chat.send.duration)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (server, quantile) (chat_send_duration_seconds{quantile=~\"0.95|0.99\"})",
          "legendFormat": "{{server}} p{{quantile}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "description": "서버 안의 저장 처리 시간(재시도·대기 포함). 브라우저까지의 전달·확정 지연은 생성기 결과(stages.json)"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "읽음 보고 처리 p95/p99 (chat.read.duration)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (server, quantile) (chat_read_duration_seconds{quantile=~\"0.95|0.99\", outcome=\"advanced\"})",
          "legendFormat": "{{server}} p{{quantile}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "max by (server) (chat_read_snapshot_duration_seconds{quantile=\"0.99\"})",
          "legendFormat": "{{server}} 스냅샷 p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hikari active / pending",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{server}} active",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "{{server}} pending",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "① 세션: Lock 대기 · idle in transaction",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_obs_sessions{wait_type=\"Lock\"}) or vector(0)",
          "legendFormat": "Lock 대기",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(pg_obs_sessions{state=~\"idle in transaction.*\"}) or vector(0)",
          "legendFormat": "idle in transaction",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "C",
          "expr": "sum(pg_obs_sessions{state=\"active\", wait_type!=\"Lock\"}) or vector(0)",
          "legendFormat": "active(그 밖)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "description": "sql_exporter ①. 조합이 없는 순간 시계열이 사라지므로 or vector(0)으로 0을 채운다"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "② 잠금 대기: 대상 표 × 잠금 종류",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target_table, lock_kind) (pg_obs_lock_waiting)",
          "legendFormat": "{{target_table}} / {{lock_kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(pg_obs_lock_waiting) or vector(0)",
          "legendFormat": "합계",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "description": "대상 표는 기다리는 쿼리 문장으로 구분(chat_room_member를 먼저 검사). 대기가 없으면 시계열이 사라진다 → 합계 줄이 0"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "③ 잠금 대기 최대 시간(상한)",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_obs_max_lock_wait_seconds",
          "legendFormat": "max(now − query_start)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "서버 CPU (process_cpu_usage)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
