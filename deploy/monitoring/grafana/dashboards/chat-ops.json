   "id": 1,
   "type": "timeseries",
   "title": "메시지 저장 p95/p99 (서버, chat.send.duration)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (server, quantile) (chat_send_duration_seconds{quantile=~\"0.95|0.99\"})",
     "legendFormat": "{{server}} p{{quantile}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
