# 프론트엔드 빌드 설정
#
# 로컬 개발에서는 비워두면 된다 — 기본값이 http://localhost:8080 이다.
# 배포에서는 프론트와 API가 같은 도메인이므로 **빈 문자열**로 두는 것이 맞다.
# 그러면 /api/... 요청이 같은 오리진으로 나가서 쿠키가 자연스럽게 실린다.
#
#   VITE_API_BASE_URL=
#
# API를 다른 도메인에 두는 경우에만 절대 주소를 넣는다:
#   VITE_API_BASE_URL=https://api.내도메인.com
VITE_API_BASE_URL=

# 채팅 읽음 보고 규칙(src/chat/readThrottle.js). 비우면 기본값(10/21 측정으로 채택): 묶기 500ms, 백오프 재전송,
# 202 뒤 2초 확인 재전송. 0이면 끈다(묶기 0 = contiguousTo가 커질 때마다 바로 보고). 재전송을 고정 간격으로: fixed
#   VITE_CHAT_READ_THROTTLE_MS=500
#   VITE_CHAT_READ_RETRY_MODE=backoff
#   VITE_CHAT_READ_CONFIRM_MS=2000
VITE_CHAT_READ_THROTTLE_MS=
